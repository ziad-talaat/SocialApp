<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Features\Group\Queries\" />
    <Folder Include="Features\Post\Queries\" />
    <Folder Include="Features\Profile\Queries\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\CommentValidation.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>CommentValidation.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GlobalValidationMessagesRes.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GlobalValidationMessagesRes.resx</DependentUpon>
    </Compile>
    <Compile Update="Resources\GroupResources\GroupValidationRes.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>GroupValidationRes.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\CommentValidation.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>CommentValidation.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GlobalValidationMessagesRes.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GlobalValidationMessagesRes.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\GroupResources\GroupValidationRes.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>GroupValidationRes.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>



	
	
	


</Project>
